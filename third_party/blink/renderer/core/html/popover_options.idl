// FlyWeb (level 130): as in Chromium 130 (8010721fc51). `invoker` is parsed
// (and type-checked) as in Chrome 130, but ignored: it only does something
// with PopoverAnchorRelationships, which is experimental upstream.
dictionary TogglePopoverOptions {
  boolean force;
  HTMLElement invoker;
};

dictionary ShowPopoverOptions {
  HTMLElement invoker;
};
